@echo -off
#
# OPPO A3 UEFI Shell startup.
# Diagnostics are ON-DEMAND: type the commands below yourself.
# Automatic periodic printing caused reboots, so it is gone.
#
echo A3 UEFI ready. On-demand eMMC checks (type manually):
echo   map -r              remap devices
echo   dh                  list all handles
echo   diskinfo            show block devices
echo   help dh             dh command syntax
